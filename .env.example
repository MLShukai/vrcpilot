# Optional environment for `just e2e-test` on Linux.
#
# Copy this file to `.env` (gitignored) and adjust if your desktop
# session lives on a non-default display, or your X authority file is
# in a non-standard location. Existing shell environment variables
# take precedence over `.env`, and `.env` is itself optional --
# `just e2e-test` falls back to the same defaults via the recipe when
# neither source provides a value.

# X11 display targeted by `just e2e-test`. SSH sessions inherit no
# DISPLAY by default, so this is what surfaces VRChat on the local
# desktop. Override only if your desktop runs on a different display.
export DISPLAY=:0

# X authority cookie file for the above display. Override if your
# session stores it in a non-default location.
export XAUTHORITY=$HOME/.Xauthority

# Optional: override the mic device substring used by `vrcpilot mic` and
# the `tests/e2e/mic.py` loopback scenario. Defaults to "CABLE Input"
# (Windows) or "VRCPilotMic" (Linux, requires `vrcpilot linux-mic
# register` first).
# export VRCPILOT_MIC_DEVICE=VRCPilotMic

# Optional: override the loopback recording substring used by the e2e
# scenario. Defaults to "CABLE Output" (Windows) or "VRCPilotMic"
# (Linux's null-sink monitor). Only consumed by tests/e2e/mic.py; the
# vrcpilot library does not read this variable.
# export VRCPILOT_MIC_LOOPBACK_DEVICE=VRCPilotMic
